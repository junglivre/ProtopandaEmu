+/**
+ * @brief Callback invoked once per descriptor visited by
+ * `esp_gdma_walk_channel_until_eof`, with that descriptor's real
+ * guest payload itself (never a reconstructed/aggregated buffer).
+ * Return false to stop the walk early, true to keep going.
+ */
+typedef bool (*esp_gdma_descriptor_cb)(void *opaque, uint32_t buf_addr,
+                                       const uint8_t *data, uint32_t length, bool is_eof);
+
+/**
+ * @brief Walk one real lap of a continuous-streaming OUT channel's
