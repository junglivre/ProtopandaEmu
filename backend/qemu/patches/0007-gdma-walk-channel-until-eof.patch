+ * @param max_descriptors Upper bound on descriptors visited per call
+ * @param cb Callback invoked once per descriptor visited
+ * @param opaque Passed through to `cb` unchanged
+ */
+bool esp_gdma_walk_channel_until_eof(ESPGdmaState *s, uint32_t chan, uint32_t max_descriptors,
+                                      esp_gdma_descriptor_cb cb, void *opaque);
