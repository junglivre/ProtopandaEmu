+/**
+ * @brief Walk one real lap of a continuous-streaming OUT channel's
+ * descriptor ring, invoking `cb` once per descriptor visited by that
+ * descriptor's real address and payload. See the header for the
+ * resume-vs-start-from-head semantics.
+ */
+bool esp_gdma_walk_channel_until_eof(ESPGdmaState *s, uint32_t chan, uint32_t max_descriptors,
+                                      esp_gdma_descriptor_cb cb, void *opaque)
+{
+    DmaConfigState* state = &s->ch_conf[ESP_GDMA_OUT_IDX][chan];
+    const bool owner_check_out = FIELD_EX32(state->conf1, GDMA_OUT_CONF1, CHECK_OWNER);
+
+    /* Resume where the previous lap left off (same mechanism the real
+     * RESTART bit uses), or start from the configured head if this
+     * channel has never been walked yet. */
+    uint32_t addr;
+    if (FIELD_EX32(state->state, GDMA_OUT_STATE, LINK_DSCR_ADDR) != 0) {
+        esp_gdma_get_restart_buffer(s, chan, ESP_GDMA_OUT_IDX, &addr);
+    } else {
+        addr = ((ESP_GDMA_RAM_ADDR >> 20) << 20) | FIELD_EX32(state->link, GDMA_OUT_LINK, ADDR);
+    }
+
+    GdmaLinkedList list;
+    bool valid = esp_gdma_read_descr(s, addr, &list);
+    if (!valid || (owner_check_out && !list.config.owner)) {
+        /* Nothing new queued by the guest yet this tick; not an error. */
+        return true;
+    }
+    esp_gdma_push_descriptor(s, chan, ESP_GDMA_OUT_IDX, addr);
+
+    bool keep_going = true;
+    uint32_t visited = 0;
+
+    while (visited < max_descriptors) {
+        const uint32_t length = list.config.length;
+        uint8_t *data = g_malloc(length ? length : 1);
+        valid = esp_gdma_read_guest(s, list.buf_addr, data, length);
+        if (!valid) {
+            g_free(data);
+            esp_gdma_set_status(&state->int_state, R_GDMA_INTERRUPT_OUT_DSCR_ERR_MASK);
+            return false;
+        }
+
+        const bool eof_bit = list.config.suc_eof;
+        keep_going = cb(opaque, list.buf_addr, data, length, eof_bit);
+        g_free(data);
+        visited++;
+
+        if (eof_bit) {
+            esp_gdma_set_status(&state->int_state, R_GDMA_INTERRUPT_OUT_EOF_MASK |
+                                                    R_GDMA_INTERRUPT_OUT_TOTAL_EOF_MASK);
+            break;
+        }
+        if (!keep_going) {
+            break;
+        }
+
+        valid = esp_gdma_next_list_node(s, chan, ESP_GDMA_OUT_IDX, &list);
+        if (!valid || (owner_check_out && !list.config.owner)) {
+            break;
+        }
+    }
+
+    esp_gdma_set_status(&state->int_state, R_GDMA_INTERRUPT_OUT_DONE_MASK);
+    return true;
+}
