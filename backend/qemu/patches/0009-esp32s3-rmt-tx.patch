From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] ESP32-S3 RMT: minimal TX channel model

The led_strip WS2812 driver waits for the RMT TX_DONE interrupt, which the
unimplemented RMT stub never raised, so any boot that shows the LED strips
blocked forever right after leds.begin(). Model the transaction lifecycle:
writing TX_START on a channel CONF0 register completes instantly and sets
the channel TX_END bit in INT_RAW; INT_ENA/ST/CLR behave as the guest
driver expects and the line asserts while (RAW & ENA). WS2812 signal
fidelity is out of scope - the HUB75 panel is the emulated display.

--- a/hw/misc/meson.build
+++ b/hw/misc/meson.build
@@ -168,6 +168,7 @@
   'esp32s3_rng.c',
   'esp32s3_sens.c',
   'esp32s3_pms.c',
+  'esp32s3_rmt.c',
   'esp_hmac.c',
   'esp32s3_hmac.c'
 ))
--- a/hw/xtensa/esp32s3.c
+++ b/hw/xtensa/esp32s3.c
@@ -51,6 +51,7 @@
 #include "hw/char/esp32s3_uart.h"
 #include "hw/misc/esp32s3_rng.h"
 #include "hw/misc/esp32s3_sens.h"
+#include "hw/misc/esp32s3_rmt.h"
 #include "hw/i2c/esp32s3_toy_ssd1306.h"
 #include "hw/display/esp32s3_toy_hub75.h"
 
@@ -130,6 +131,7 @@
     Esp32s3RngState rng;
     Esp32s3SensState sens;
     Esp32I2CState i2c0;
+    Esp32S3RmtState rmt;
     Esp32s3ToyHub75State toy_hub75;
     Esp32S3TWAIState twai;
 
@@ -650,6 +652,7 @@
     object_initialize_child(OBJECT(ss), "rng", &ss->rng, TYPE_ESP32S3_RNG);
     object_initialize_child(OBJECT(ss), "sens", &ss->sens, TYPE_ESP32S3_SENS);
     object_initialize_child(OBJECT(ss), "i2c0", &ss->i2c0, TYPE_ESP32_I2C);
+    object_initialize_child(OBJECT(ss), "rmt", &ss->rmt, TYPE_ESP32S3_RMT);
     object_initialize_child(OBJECT(ss), "toy_hub75", &ss->toy_hub75, TYPE_ESP32S3_TOY_HUB75);
 
     object_initialize_child(OBJECT(ss), "clock", &ss->clock, TYPE_ESP32S3_CLOCK);
--- a/hw/misc/esp32s3_rmt.c
+++ b/hw/misc/esp32s3_rmt.c
@@ -0,0 +1,162 @@
+/*
+ * ESP32-S3 Remote Control (RMT) minimal TX model for ProtopandaEmu
+ *
+ * The led_strip WS2812 driver (FastLED's bundled led_strip) only needs the
+ * RMT transaction lifecycle: a TX channel start and its TX_DONE interrupt.
+ * On real silicon the RMT encoder streams pulse timings over the GPIO matrix;
+ * the emulator has no wire to model, so a TX start completes instantly and
+ * raises the channel TX_END interrupt. WS2812 signal fidelity is out of scope
+ * here (the HUB75 panel is the emulated display).
+ *
+ * Copyright (c) 2026 ProtopandaEmu project
+ * GPL-2.0-or-later, matching the surrounding QEMU fork sources.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/hw.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/esp32s3_rmt.h"
+#include "hw/registerfields.h"
+
+/* 8 TX/RX channels, legacy S3 register layout */
+#define RMT_CHANNEL_COUNT 8
+
+REG32(RMT_INT_RAW, 0x70)
+REG32(RMT_INT_ST, 0x74)
+REG32(RMT_INT_ENA, 0x78)
+REG32(RMT_INT_CLR, 0x7c)
+
+/* TX channel n CONF0 register: 0x20 + 4n, TX_START is bit 0 */
+#define RMT_CH0CONF0_OFFSET 0x20
+#define RMT_TX_START_BIT BIT(0)
+/* INT_RAW TX_END bits: channel n = BIT(n) */
+#define RMT_CH_TX_END_BIT(n) BIT(n)
+
+static void esp32s3_rmt_update_irq(Esp32S3RmtState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_ena) ? 1 : 0);
+}
+
+static void esp32s3_rmt_tx_start(Esp32S3RmtState *s, unsigned channel)
+{
+    /* The emulated transmission completes immediately: raise TX_END. */
+    s->int_raw |= RMT_CH_TX_END_BIT(channel);
+    esp32s3_rmt_update_irq(s);
+}
+
+static uint64_t esp32s3_rmt_read(void *opaque, hwaddr offset, unsigned size)
+{
+    Esp32S3RmtState *s = ESP32S3_RMT(opaque);
+
+    switch (offset) {
+        case A_RMT_INT_RAW:
+            return s->int_raw;
+        case A_RMT_INT_ST:
+            return s->int_raw & s->int_ena;
+        case A_RMT_INT_ENA:
+            return s->int_ena;
+        default:
+            break;
+    }
+    if (offset < ARRAY_SIZE(s->regs) * sizeof(uint32_t)) {
+        return s->regs[offset / sizeof(uint32_t)];
+    }
+    qemu_log_mask(LOG_UNIMP, "%s: read@0x%02lx\n", __func__, (unsigned long) offset);
+    return 0;
+}
+
+static void esp32s3_rmt_write(void *opaque, hwaddr offset,
+                              uint64_t value, unsigned size)
+{
+    Esp32S3RmtState *s = ESP32S3_RMT(opaque);
+
+    switch (offset) {
+        case A_RMT_INT_ENA:
+            s->int_ena = value;
+            esp32s3_rmt_update_irq(s);
+            return;
+        case A_RMT_INT_CLR:
+            s->int_raw &= ~value;
+            esp32s3_rmt_update_irq(s);
+            return;
+        case A_RMT_INT_RAW:
+            /* W1TS semantics live on INT_SET in newer SoCs; on S3 RAW writes
+             * have no effect. Ignore. */
+            return;
+        default:
+            break;
+    }
+
+    if (offset >= RMT_CH0CONF0_OFFSET &&
+        offset < RMT_CH0CONF0_OFFSET + RMT_CHANNEL_COUNT * sizeof(uint32_t)) {
+        unsigned channel = (offset - RMT_CH0CONF0_OFFSET) / sizeof(uint32_t);
+        hwaddr conf_offset = RMT_CH0CONF0_OFFSET + channel * sizeof(uint32_t);
+        if (offset == conf_offset) {
+            s->regs[offset / sizeof(uint32_t)] = value;
+            if (value & RMT_TX_START_BIT) {
+                esp32s3_rmt_tx_start(s, channel);
+            }
+            return;
+        }
+    }
+
+    if (offset < ARRAY_SIZE(s->regs) * sizeof(uint32_t)) {
+        s->regs[offset / sizeof(uint32_t)] = value;
+        return;
+    }
+    qemu_log_mask(LOG_UNIMP, "%s: write@0x%02lx value=0x%08lx\n",
+                  __func__, (unsigned long) offset, (unsigned long) value);
+}
+
+static const MemoryRegionOps esp32s3_rmt_ops = {
+    .read = esp32s3_rmt_read,
+    .write = esp32s3_rmt_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static void esp32s3_rmt_reset_hold(Object *obj, ResetType type)
+{
+    Esp32S3RmtState *s = ESP32S3_RMT(obj);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->int_raw = 0;
+    s->int_ena = 0;
+}
+
+static void esp32s3_rmt_init(Object *obj)
+{
+    Esp32S3RmtState *s = ESP32S3_RMT(obj);
+
+    memory_region_init_io(&s->iomem, obj, &esp32s3_rmt_ops, s,
+                          TYPE_ESP32S3_RMT, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->irq);
+}
+
+static void esp32s3_rmt_class_init(ObjectClass *klass, void *data)
+{
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    rc->phases.hold = esp32s3_rmt_reset_hold;
+}
+
+static const TypeInfo esp32s3_rmt_info = {
+    .name = TYPE_ESP32S3_RMT,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32S3RmtState),
+    .instance_init = esp32s3_rmt_init,
+    .class_init = esp32s3_rmt_class_init,
+};
+
+static void esp32s3_rmt_register_types(void)
+{
+    type_register_static(&esp32s3_rmt_info);
+}
+
+type_init(esp32s3_rmt_register_types);
--- a/include/hw/misc/esp32s3_rmt.h
+++ b/include/hw/misc/esp32s3_rmt.h
@@ -0,0 +1,29 @@
+/*
+ * ESP32-S3 Remote Control (RMT) minimal TX model for ProtopandaEmu
+ */
+#ifndef HW_ESP32S3_RMT_H
+#define HW_ESP32S3_RMT_H
+
+#include "qom/object.h"
+#include "hw/sysbus.h"
+
+#define TYPE_ESP32S3_RMT "esp32s3-rmt"
+OBJECT_DECLARE_SIMPLE_TYPE(Esp32S3RmtState, ESP32S3_RMT)
+
+struct Esp32S3RmtState {
+    /*< private >*/
+    SysBusDevice parent_obj;
+
+    /*< public >*/
+    MemoryRegion iomem;
+    qemu_irq irq;
+
+    /* Everything from 0x0 to 0x6ff (CHDATA, CONF0/1, CARRIER, RX regs,
+     * SYS_CONF, TX_SIM...) kept verbatim; the interrupt registers and the
+     * TX_START handling are modeled explicitly. */
+    uint32_t regs[0x180];
+    uint32_t int_raw;
+    uint32_t int_ena;
+};
+
+#endif /* HW_ESP32S3_RMT_H */
