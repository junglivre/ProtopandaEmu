+    /* Rock 4 experimental I2C bus with a toy SSD1306-shaped slave. */
+    {
+        sysbus_realize(SYS_BUS_DEVICE(&ss->i2c0), &error_fatal);
+        MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(&ss->i2c0), 0);
+        memory_region_add_subregion_overlap(sys_mem, DR_REG_I2C_EXT_BASE, mr, 0);
+        sysbus_connect_irq(SYS_BUS_DEVICE(&ss->i2c0), 0,
+                           qdev_get_gpio_in(intmatrix_dev, ETS_I2C_EXT1_INTR_SOURCE));
+        i2c_slave_create_simple(I2C_BUS(qdev_get_child_bus(DEVICE(&ss->i2c0), "i2c")),
+                                TYPE_ESP32S3_TOY_SSD1306, 0x3c);
+    }
+
+    /* Rock 4 experimental LCD_CAM/HUB75-shaped DMA sink. */
+    {
+        object_property_set_link(OBJECT(&ss->toy_hub75), "soc_mr", OBJECT(dram),
+                                  &error_abort);
+        sysbus_realize(SYS_BUS_DEVICE(&ss->toy_hub75), &error_fatal);
+        MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(&ss->toy_hub75), 0);
+        memory_region_add_subregion_overlap(sys_mem, DR_REG_LCD_CAM_BASE, mr, 0);
+    }
