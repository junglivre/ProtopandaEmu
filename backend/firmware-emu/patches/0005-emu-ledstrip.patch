@@ -258,6 +263,33 @@ void LedStrip::Display(){
     if (!m_enabled){
         return;
     }
+#ifdef PROTOPANDAEMU_EMU
+    // QEMU's RMT model completes the FastLED.show() transaction but
+    // doesn't decode WS2812 signal timing, so dump the real computed
+    // buffer instead -- a firmware-side capture, not a wire trace.
+    // Throttled + change-gated to keep steady-state cost low.
+    if (m_ledAmount > 0 && m_leds != nullptr){
+        static uint32_t lastDumpMs = 0;
+        static CRGB lastDumped[256];
+        static bool everDumped = false;
+        uint32_t now = millis();
+        int count = m_ledAmount > 256 ? 256 : m_ledAmount;
+        bool changed = !everDumped || memcmp(lastDumped, m_leds, count * sizeof(CRGB)) != 0;
+        if (changed && (now - lastDumpMs) >= 100){
+            Serial.print("[EMU] LED_DUMP count=");
+            Serial.print(count);
+            Serial.print(" hex=");
+            for (int i = 0; i < count; i++){
+                Serial.printf("%02x%02x%02x", m_leds[i].r, m_leds[i].g, m_leds[i].b);
+            }
+            Serial.print("\n");
+            memcpy(lastDumped, m_leds, count * sizeof(CRGB));
+            everDumped = true;
+            lastDumpMs = now;
+        }
+    }
+    return;
+#endif
     if (m_ledAmount > 0 && !m_hasScreen){
         FastLED.show(); 
     }
