+#ifdef PROTOPANDAEMU_EMU
+// The LED_DUMP above (LedStrip::Display) always reports full/undimmed
+// color, same as HUB75: FastLED.setBrightness() is a separate global
+// scalar applied at output time, never baked into m_leds[]. Dump this
+// choke point instead, throttled and change-gated -- the gentle-ramp
+// step below calls it every frame while ramping.
+static void emuDumpLedBrightness(uint8_t b){
+    static uint8_t lastDumped = 0;
+    static bool everDumped = false;
+    static uint32_t lastDumpMs = 0;
+    uint32_t now = millis();
+    if ((!everDumped || b != lastDumped) && (now - lastDumpMs) >= 100){
+        Serial.printf("[EMU] LED_BRIGHTNESS value=%u\n", (unsigned)b);
+        lastDumped = b;
+        everDumped = true;
+        lastDumpMs = now;
+    }
+}
+#endif
