+#ifdef PROTOPANDAEMU_EMU
+// Overrides digitalRead() itself (not boop.lua, which loads from the SD
+// card at runtime and isn't ours to patch), so every Lua caller sees it
+// transparently. emuGetGpioOverride() is defined in main.cpp.
+int emuGetGpioOverride(int pin);
+int emuDigitalRead(uint8_t pin)
+{
+  int override = emuGetGpioOverride(pin);
+  if (override >= 0) return override;
+  return digitalRead(pin);
+}
+#endif
