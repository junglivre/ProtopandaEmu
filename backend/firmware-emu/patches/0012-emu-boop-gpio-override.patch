+#ifdef PROTOPANDAEMU_EMU
+/* Defined in main.cpp: -1 = no override (use the real hardware read),
+ * 0/1 = forced level, set over the console with "GPIO:<pin>:<0|1>". This
+ * wraps the real digitalRead() -- not a separate Lua-visible function --
+ * so every caller sees the override transparently, including Lua scripts
+ * loaded from the SD card (boop.lua's trigger_mode="gpio" check among
+ * them), none of which this project's source controls. */
+int emuGetGpioOverride(int pin);
+int emuDigitalRead(uint8_t pin)
+{
+  int override = emuGetGpioOverride(pin);
+  if (override >= 0) {
+    return override;
+  }
+  return digitalRead(pin);
+}
+#endif
