 #include "drawing/modelanimation/keyframeplayer.hpp"
 
+#ifdef PROTOPANDAEMU_EMU
+/* Simulated GPIO digital-input overrides: any firmware code that reads a
+ * pin through emuDigitalReadOverride() (see boop.lua) gets this value
+ * instead of the real (floating, unconnected) emulated pin whenever the
+ * host has injected one over the console with "GPIO:<pin>:<0|1>". -1
+ * means "no override, use the real hardware read". */
+static int8_t g_emuGpioOverride[49];
+static bool g_emuGpioOverrideInit = false;
+int emuGetGpioOverride(int pin) {
+  if (!g_emuGpioOverrideInit) {
+    for (int i = 0; i < 49; i++) g_emuGpioOverride[i] = -1;
+    g_emuGpioOverrideInit = true;
+  }
+  if (pin < 0 || pin >= 49) return -1;
+  return g_emuGpioOverride[pin];
+}
+static void emuSetGpioOverride(int pin, int state) {
+  if (!g_emuGpioOverrideInit) {
+    for (int i = 0; i < 49; i++) g_emuGpioOverride[i] = -1;
+    g_emuGpioOverrideInit = true;
+  }
+  if (pin < 0 || pin >= 49) return;
+  g_emuGpioOverride[pin] = (int8_t)state;
+}
+#endif
+
 
