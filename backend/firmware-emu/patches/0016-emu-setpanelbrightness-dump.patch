diff --git a/src/lua/luafunctions/drawingfunctions.cpp b/src/lua/luafunctions/drawingfunctions.cpp
index e69788f..d7158c6 100644
--- a/src/lua/luafunctions/drawingfunctions.cpp
+++ b/src/lua/luafunctions/drawingfunctions.cpp
@@ -73,6 +73,27 @@ void setPanelBrightness(uint8_t bright)
 {
   Devices::Display->setBrightness8(bright);
   Devices::Display->setBrightnessExt(bright);
+#ifdef PROTOPANDAEMU_EMU
+  /* menu.lua/screentest.lua call this directly for runtime brightness
+   * changes (the settings menu's brightness slider, the calibration
+   * screen) -- a separate path from Devices::SetMaxBrightness(), which
+   * only ever sees the startup gentle ramp. Without this, the launcher's
+   * preview brightness only ever reflected that one startup ramp and
+   * never updated again for the rest of the session. Independent
+   * throttle state from devices.cpp's hook: the two call sites are
+   * genuinely different code, duplicating four static locals is cheaper
+   * than plumbing a shared helper across translation units for it. */
+  static uint8_t lastDumped = 0;
+  static bool everDumped = false;
+  static uint32_t lastDumpMs = 0;
+  uint32_t now = millis();
+  if ((!everDumped || bright != lastDumped) && (now - lastDumpMs) >= 100){
+    Serial.printf("[EMU] HUB75_BRIGHTNESS value=%u\n", (unsigned)bright);
+    lastDumped = bright;
+    everDumped = true;
+    lastDumpMs = now;
+  }
+#endif
   return;
 }
 
