+
 void InfraRedManager::decodeIR() {
     if (m_counter < 68) {
         return;
@@ -124,7 +130,22 @@ void InfraRedManager::setInterruptPin(uint16_t p){
     if (m_interruptPin != 0){
         disableInterrupt();
     }
+#ifdef PROTOPANDAEMU_EMU
+    /* Configure the pin directly: pinMode() re-registers the GPIO in the
+     * Arduino peripheral manager, which detaches any SDMMC bus sharing it
+     * (v3.4.0 keybinds ship infrared_gpio == MMC_PIN_CLK == 21) and unmounts
+     * storage mid-boot. The emulator's SDMMC model does not drive the GPIO
+     * matrix, so IR input and the SD bus can share the pin here. */
+    gpio_config_t emuConf = {};
+    emuConf.pin_bit_mask = 1ULL << p;
+    emuConf.mode = GPIO_MODE_INPUT;
+    emuConf.pull_up_en = GPIO_PULLUP_DISABLE;
+    emuConf.pull_down_en = GPIO_PULLDOWN_DISABLE;
+    emuConf.intr_type = GPIO_INTR_DISABLE;
+    gpio_config(&emuConf);
+#else
     pinMode(p, INPUT);
+#endif
     delay(1);
     m_interruptPin = digitalPinToInterrupt(p);
 }
