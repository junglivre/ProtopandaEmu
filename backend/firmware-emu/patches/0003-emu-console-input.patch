+// Console-injected overrides, consumed by other translation units via
+// the extern getters below. -1 means "no override, use the real read".
+static int8_t g_emuGpioOverride[49];
+static bool g_emuGpioOverrideInit = false;
+int emuGetGpioOverride(int pin) {
+  if (!g_emuGpioOverrideInit) {
+    for (int i = 0; i < 49; i++) g_emuGpioOverride[i] = -1;
+    g_emuGpioOverrideInit = true;
+  }
+  if (pin < 0 || pin >= 49) return -1;
+  return g_emuGpioOverride[pin];
+}
+static void emuSetGpioOverride(int pin, int state) {
+  if (!g_emuGpioOverrideInit) {
+    for (int i = 0; i < 49; i++) g_emuGpioOverride[i] = -1;
+    g_emuGpioOverrideInit = true;
+  }
+  if (pin < 0 || pin >= 49) return;
+  g_emuGpioOverride[pin] = (int8_t)state;
+}
+
+static int g_emuFFTBandOverride[64];
+static bool g_emuFFTBandOverrideInit = false;
+static void emuInitFFTBandOverride() {
+  if (g_emuFFTBandOverrideInit) return;
+  for (int i = 0; i < 64; i++) g_emuFFTBandOverride[i] = -1;
+  g_emuFFTBandOverrideInit = true;
+}
+int emuGetFFTBandOverride(int band) {
+  emuInitFFTBandOverride();
+  if (band < 0 || band >= 64) return -1;
+  return g_emuFFTBandOverride[band];
+}
+static void emuSetFFTBandOverride(int band, int value) {
+  emuInitFFTBandOverride();
+  if (band < 0 || band >= 64) return;
+  g_emuFFTBandOverride[band] = value;
+}
+#endif
 
