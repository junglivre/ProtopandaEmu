--- a/src/tools/fft.cpp
+++ b/src/tools/fft.cpp
@@ -201,9 +201,26 @@ bool FFT::isRunning(){
     return m_running; 
 }
 
+#ifdef PROTOPANDAEMU_EMU
+/* Defined in main.cpp: -1 = no override (use the real, always-zero
+ * result -- this backend has no continuous/DMA ADC model, so
+ * readAndAnalyse()'s adc_continuous_read() always times out and
+ * m_bandValues never gets written), >=0 = a per-band energy value
+ * injected over the console with "MIC:<value>\n", standing in for the
+ * host microphone's level since this firmware only ever treats FFT
+ * band energy as an overall loudness signal, not real spectral content. */
+int emuGetFFTBandOverride();
+#endif
+
 int FFT::getBandValue(int i){
     if (!m_running)               return 0;
     if (i < 0 || i >= m_bandCount) return 0;
+#ifdef PROTOPANDAEMU_EMU
+    int override = emuGetFFTBandOverride();
+    if (override >= 0) {
+        return override;
+    }
+#endif
     return m_bandValues[i];
 }
 
