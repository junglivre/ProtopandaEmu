     return m_running; 
 }
 
+#ifdef PROTOPANDAEMU_EMU
+/* Defined in main.cpp: -1 = no override for this band (use the real,
+ * always-zero result -- this backend has no continuous/DMA ADC model,
+ * so readAndAnalyse()'s adc_continuous_read() always times out and
+ * m_bandValues never gets written), >=0 = this band's energy value
+ * injected over the console with "MIC:<band>:<value>\n", standing in
+ * for a host microphone or the GUI's equalizer popup since this
+ * firmware only ever treats FFT band energy as a loudness signal, not
+ * real captured spectral content. */
+int emuGetFFTBandOverride(int band);
+#endif
+
 int FFT::getBandValue(int i){
     if (!m_running)               return 0;
     if (i < 0 || i >= m_bandCount) return 0;
+#ifdef PROTOPANDAEMU_EMU
+    int override = emuGetFFTBandOverride(i);
+    if (override >= 0) {
+        return override;
+    }
+#endif
     return m_bandValues[i];
 }
 
