+
+/* Simulated FFT per-band energy override: FFT::getBandValue() (see
+ * fft.cpp) returns this for every band index whenever the host has
+ * injected a level over the console with "MIC:<value>\n", standing in
+ * for the host microphone's volume since this backend has no
+ * continuous/DMA ADC model and the firmware only ever treats FFT band
+ * energy as an overall loudness signal, not real spectral content.
+ * -1 means "no override, use the real (always-zero) ADC result". */
+static int g_emuFFTBandOverride = -1;
+int emuGetFFTBandOverride() {
+  return g_emuFFTBandOverride;
+}
+static void emuSetFFTBandOverride(int value) {
+  g_emuFFTBandOverride = value;
+}
 #endif
 
 
