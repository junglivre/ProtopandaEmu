 }
+
+/* Simulated FFT per-band energy override: FFT::getBandValue(i) (see
+ * fft.cpp) returns this for band i whenever the host has injected a
+ * level for that band over the console with "MIC:<band>:<value>\n",
+ * standing in for the host microphone's volume since this backend has
+ * no continuous/DMA ADC model and real band index i is never a
+ * meaningful spectral read to begin with. Per-band (not one value for
+ * every band) so the GUI's equalizer popup can drive each band
+ * independently -- a single uniform value made every band rise
+ * together, which doesn't exercise whatever band-shape-sensitive logic
+ * downstream Lua might have. -1 means "no override, use the real
+ * (always-zero) ADC result". Sized for the largest bandCount
+ * FFT::begin() accepts in practice; out-of-range indices are ignored,
+ * matching the real bandCount bounds check in FFT::getBandValue(). */
+static int g_emuFFTBandOverride[64];
+static bool g_emuFFTBandOverrideInit = false;
+static void emuInitFFTBandOverride() {
+  if (g_emuFFTBandOverrideInit) return;
+  for (int i = 0; i < 64; i++) { g_emuFFTBandOverride[i] = -1; }
+  g_emuFFTBandOverrideInit = true;
+}
+int emuGetFFTBandOverride(int band) {
+  emuInitFFTBandOverride();
+  if (band < 0 || band >= 64) return -1;
+  return g_emuFFTBandOverride[band];
+}
+static void emuSetFFTBandOverride(int band, int value) {
+  emuInitFFTBandOverride();
+  if (band < 0 || band >= 64) return;
+  g_emuFFTBandOverride[band] = value;
+}
 #endif
 
 
