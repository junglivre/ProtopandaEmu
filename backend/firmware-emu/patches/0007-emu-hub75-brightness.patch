+++ b/src/lua/luafunctions/drawingfunctions.cpp
@@ -73,6 +73,22 @@ void setPanelBrightness(uint8_t bright)
 {
   Devices::Display->setBrightness8(bright);
   Devices::Display->setBrightnessExt(bright);
+#ifdef PROTOPANDAEMU_EMU
+  // Runtime brightness changes (settings menu, calibration screens) go
+  // through here, not Devices::SetMaxBrightness() -- its own dump only
+  // ever saw the startup ramp. Same throttle/change-gate, independent
+  // state (different translation unit).
+  static uint8_t lastDumped = 0;
+  static bool everDumped = false;
+  static uint32_t lastDumpMs = 0;
+  uint32_t now = millis();
+  if ((!everDumped || bright != lastDumped) && (now - lastDumpMs) >= 100){
+    Serial.printf("[EMU] HUB75_BRIGHTNESS value=%u\n", (unsigned)bright);
+    lastDumped = bright;
+    everDumped = true;
+    lastDumpMs = now;
+  }
+#endif
   return;
 }
 
